# =============================================================================
# Root `.env` template
# =============================================================================
# Copy to `.env` and fill in values. Do not commit real secrets.
# Keep this file updated when you add new variables (see also `turbo.json` → `globalEnv`).

# =============================================================================
# AWS Secrets Manager ↔ local `.env` (`pnpm env:pull` / `pnpm env:push`)
# =============================================================================
# Scripts: `tooling/sst-bootstrap/scripts/`. Set these when using pull/push (optional).
#
# ENV_TARGET / --env-target: `root` | `.` | omit → repo root `.env`; `web` | `api` → `apps/<name>/.env`
# Pull overwrites the target file only (no merge). Use --out / --file to override path.
#
# Secret name = `{SM_PREFIX or SST_STAGE or STAGE}/{SECRET_NAME}/{ENV_TARGET}` (omit unused segments).
#   Example: SECRET_NAME=environments, ENV_TARGET=root → secret id `environments/root`
#   With SM_PREFIX=offline → `offline/environments/root`
# Full secret ARN as SECRET_NAME skips prefix composition.
# Plain-text secret → one key (SECRETS_MANAGER_PLAIN_KEY, default SECRET_VALUE); JSON → one key per field.
#
# SECRET_NAME=environments
# ENV_TARGET=root
# SM_PREFIX=offline
# AWS_REGION=ap-northeast-1
# SSM_ENV_PATH=   # legacy alias for SECRET_NAME

# =============================================================================
# SST & AWS (all `apps/*/sst.config.ts` providers)
# =============================================================================
# Logical deploy stage: also drives `resolveDeployStage()` (batch schedules, optional branching in
# `pnpm db:seed` — see `packages/db-backbone/README.md` and `packages/shared/README.md`).
SST_STAGE=offline
# Required only to load example data outside `offline` and `test`.
SEED_SAMPLE_DATA=false

# Local non-production only: named AWS profile for `sst dev` / `sst deploy`
# (omit in CI). Production stages are restricted to GitHub Actions.
SST_AWS_PROFILE=my-dev-profile

# Region for SST AWS provider (S3, CloudFront, Lambda, etc.). Default in each `sst.config.ts` if unset.
SST_AWS_REGION=us-east-1

# =============================================================================
# Lambda VPC — `@arlequins/env` `vpcFromEnv()` → `apps/api` and `apps/batch` functions
# =============================================================================
# Comma-separated IDs. If SUBNET_IDS or SECURITY_GROUP_IDS is empty, Lambdas are not in a VPC.
# VPC_ID is optional (documentation / future use); attachment uses subnet + security group IDs only.
#
# VPC_ID=vpc-0123456789abcdef0
# SUBNET_IDS=subnet-0aaa...,subnet-0bbb...
# SECURITY_GROUP_IDS=sg-0ccc...

# =============================================================================
# PostgreSQL — `@arlequins/env` `loadDatabaseEnv()` → `@arlequins/db-backbone` (Drizzle, postgres.js)
# =============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=app
DATABASE_SSL_MODE=disable

# Pool size for postgres.js (default 10). See `packages/env/src/database.ts`.
# POSTGRES_POOL_MAX=10

# =============================================================================
# OpenID Connect — SPA Authorization Code + PKCE and API JWT validation
# =============================================================================
# Register these browser redirect URIs with the provider:
#   http://localhost:3000/auth/callback/
#   http://localhost:3000/auth/logout-callback/
OIDC_MOCK_PORT=5556
OIDC_MOCK_ISSUER=http://localhost:5556
OIDC_ISSUER_URL=http://localhost:5556
OIDC_AUDIENCE=http://localhost:5000
# OIDC_JWKS_URI=https://idp.example.com/.well-known/jwks.json
OIDC_ALLOWED_ALGORITHMS=RS256
# Exact `issuer|subject` identities granted the initial administrator role.
# AUTH_BOOTSTRAP_ADMIN_IDENTITIES=https://id.example.com|user-subject
# Optional multi-provider override. JSON array entries use id, issuer, audience, algorithms, and optional jwksUri.
# OIDC_PROVIDERS_JSON=[{"id":"workforce","issuer":"https://id.example.org","audience":["api"],"algorithms":["RS256"]}]

NEXT_PUBLIC_OIDC_AUTHORITY=http://localhost:5556
NEXT_PUBLIC_OIDC_CLIENT_ID=local-web
NEXT_PUBLIC_OIDC_RESOURCE=http://localhost:5000
NEXT_PUBLIC_OIDC_SCOPE=openid profile email

# =============================================================================
# Next.js (`apps/web`) — baked into StaticSite at deploy; dev uses localhost defaults below
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Hono API. CORS defaults to NEXT_PUBLIC_SITE_URL when omitted.
API_PORT=5000
API_CORS_ORIGINS=http://localhost:3000
# Keep at least 1048576 when the administrator attaches optimized Gourmet images.
# API_BODY_LIMIT_BYTES=1048576
# API_RATE_LIMIT_REQUESTS=120
# API_RATE_LIMIT_WINDOW_SECONDS=60
# ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:application-alerts

# AWS API endpoint. `function-url` is the lowest-cost default; `api-gateway` adds
# managed access logs, custom domains, and per-stage throttling.
API_DEPLOYMENT_PRESET=function-url
# API_CUSTOM_DOMAIN=api.example.com

# Function URL preset only. Enabling WAF or a custom domain adds an SST Router
# (CloudFront) in front of the Function URL.
API_WAF_ENABLED=false

# API Gateway preset only. Defaults: 100 requests/second, burst 200.
# API_THROTTLE_RATE_LIMIT=100
# API_THROTTLE_BURST_LIMIT=200

# =============================================================================
# Beat production identity — S3 bucket names are generated by the API SST stack
# =============================================================================
# Keep these values in AWS Secrets Manager for production. Generate at least 32
# random bytes for the lookup secret and an ES256 private JWK for token signing.
# BEAT_AUTH_LOOKUP_SECRET=replace-with-at-least-32-random-characters
# BEAT_AUTH_ISSUER_URL=https://api.example.com/auth
# BEAT_AUTH_AUDIENCE=beat-agent
# BEAT_AUTH_SIGNING_PRIVATE_JWK={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}
# BEAT_AUTH_SIGNING_KEY_ID=beat-auth-2026-01
# Google SSO is used by the Beat OIDC authorization endpoint when all three
# client values are configured. Keep the client secret in the protected
# runtime secret, never in the browser or GitHub variables.
# BEAT_AUTH_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# BEAT_AUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
# BEAT_AUTH_GOOGLE_REDIRECT_URI=https://your-beat-api.example.com/auth/google/callback
# BEAT_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Public OIDC SPA client allowlist. Redirect and logout URIs are exact matches;
# keep the final Agent origin in the protected production Environment variable.
# BEAT_AUTH_CLIENTS_JSON=[{"client_id":"beat-agent-web","redirect_uris":["https://agent.example.com/auth/callback/"],"post_logout_redirect_uris":["https://agent.example.com/auth/logout-callback/"],"scopes":["openid","profile","email","offline_access"]}]
# BEAT_AUTH_AUTHORIZATION_CODE_TTL_SECONDS=60
# Separate Bearer key for the personal Custom GPT gourmet Action. Keep this
# only in Secrets Manager in production; do not expose it to the web bundle.
# BEAT_GOURMET_ACTION_API_KEY=replace-with-at-least-32-random-characters
#
# SST supplies these to Lambda. Set them locally only when testing against
# operator-managed S3 buckets.
# BEAT_AUTH_STATE_BUCKET=beat-auth-state-local
# BEAT_AUTH_LEDGER_BUCKET=beat-auth-ledger-local
# BEAT_AUTH_STATE_PREFIX=v1
# BEAT_AUTH_LEDGER_RETENTION_DAYS=365
#
# Production administrator, recovery, and qualification inputs are accepted
# only by the protected GitHub Actions workflow. Do not put them in this file
# or in the production runtime secret.
# BEAT_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# BEAT_ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-unique-password
# The Production operations workflow copies a selected recovery version into
# `v1/recovery/` and never overwrites a live head.
# BEAT_RECOVERY_SOURCE_KEY=v1/drafts/example/head.json
# BEAT_RECOVERY_VERSION_ID=replace-with-an-s3-version-id
# The Production operations workflow requires this explicit acknowledgement for
# real-bucket qualification, which creates retained evidence objects.
# BEAT_PRODUCTION_QUALIFICATION_CONFIRM=production
#
# GitHub App used only by the server-side publication workflow.
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=12345678
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# GITHUB_CONTENT_REPOSITORY=arlequins/beat

# =============================================================================
# OpenTelemetry — optional OTLP/HTTP trace and metric export
# =============================================================================
# Leave the endpoint unset for the zero-configuration local default. When set,
# the API exports to <endpoint>/v1/traces and <endpoint>/v1/metrics.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=api
# OTEL_SERVICE_VERSION=1.0.0
# Percent-encode header values that contain spaces or commas. Keep secrets out of committed files.
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20token

# =============================================================================
# S3 application cache — optional locally, provisioned by the API SST stack
# =============================================================================
# Omit S3_CACHE_BUCKET to disable caching without affecting API or DB behavior.
# S3_CACHE_BUCKET=my-application-cache
# S3_CACHE_PREFIX=offline
# S3_CACHE_TTL_SECONDS=300
# S3-compatible local services can also set these values.
# S3_CACHE_ENDPOINT=http://localhost:9000
# S3_CACHE_FORCE_PATH_STYLE=true

# Optional generic file-upload adapter. The API returns short-lived PUT URLs.
# S3_UPLOAD_BUCKET=my-application-uploads
# S3_UPLOAD_PREFIX=uploads
