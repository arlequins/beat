{
  "manifest_version": 3,
  "name": "Beat Gourmet export",
  "version": "0.1.0",
  "description": "Export images from the current ChatGPT conversation to Beat Gourmet drafts.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Beat로 내보내기"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://arlequins.github.io/beat/admin/*",
    "http://localhost:43100/admin/*",
    "https://4kfwvp7y2qoprape5p2jr5qvra0ekgcl.lambda-url.ap-northeast-1.on.aws/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content-chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://arlequins.github.io/beat/admin/*",
        "http://localhost:43100/admin/*"
      ],
      "js": ["content-beat-admin.js"],
      "run_at": "document_idle"
    }
  ]
}
